# Environment variables
.env
.env.local
.env.*.local

# Node.js (frontend/)
node_modules/
frontend/dist/
frontend/dist-archive/
frontend/dev-dist/
# Built by `npm run build:archive`, served as a static asset of the main build
frontend/public/hearth-archive.html
/package.json
/package-lock.json

# Go (backend/)
backend/bin/
backend/*.test
backend/*.out

# Terraform — the tracked files were deleted with ADR 0005, but the local production.tfvars and
# .terraform/ state hold real values and are still on disk. These rules keep them out of a public
# repository; delete the rules only once you have deleted those local files too.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/**/*.tfvars
!terraform/**/*.tfvars.example

# make dev / dev-stop — pidfiles + logs for the background dev servers
.dev/

# Knowledge-base build output (kb/build_kb.py); the committed source is kb/reviewed/
kb/out/

# Mobile shells (mobile/) — the web build is copied in by `make mobile-web`, never committed, and
# the Xcode project is generated from project.yml.
mobile/android/app/src/main/assets/web/
mobile/android/app/build/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Hearth/Web/
mobile/ios/Hearth.xcodeproj/
mobile/ios/build/
mobile/ios/Configuration/Local.xcconfig
mobile/ios/build/
# Generated by `make ios-ipa` from ExportOptions.plist.example: its teamID is an account id.
mobile/ios/ExportOptions.plist
# fastlane (mobile/Gemfile) and anything a release step leaves behind. Signing material never
# belongs in the repository at all — keystores, service-account JSON and .p8 keys live outside it
# (docs/runbook/store-release.md) — but these rules make an accident harder.
mobile/vendor/
mobile/fastlane/report.xml
mobile/fastlane/README.md
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Database files (local backend)
*.db
*.db-wal
*.db-shm

# IDE / OS
.vscode/
.idea/
.DS_Store
__pycache__/
*.pyc

# Claude Code session data
.claude/projects/
.claude/settings.local.json

# Local test folders for the backup-folder and portable-archive features (real genetic data)
/backup/
/standalone/

# Generated by XcodeGen from mobile/ios/project.yml
mobile/ios/Hearth/Info.plist
