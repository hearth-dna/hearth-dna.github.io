# Copy to .env and fill in. .env is gitignored — never commit it.

# Mobile publishing (docs/runbook/store-release.md). All optional: the apps build, run and are
# testable without any of them — only store uploads need them. None of these values may ever be
# committed; .env is gitignored, and CI reads the same names from GitHub secrets.

# The published app id, reverse-DNS of a domain you own. Unset means the committed placeholder
# `example.hearth.app`, which is fine for development and is refused by every publish target.
# Play and App Store Connect both fix this permanently at the first upload.
HEARTH_APPLICATION_ID=

# Play upload key. The keystore itself lives outside the repository — `make android-keystore`
# creates it at ~/.hearth/hearth-upload.jks. Losing it means the published app can never be
# updated again, so back it up somewhere durable.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=upload
ANDROID_KEY_PASSWORD=

# Path to the Google Play service-account JSON (Play Console → Users and permissions → API access).
PLAY_SERVICE_ACCOUNT_JSON=

# Apple. APPLE_TEAM_ID signs the archive; the ASC_* values are an App Store Connect API key
# (Users and Access → Integrations → App Store Connect API) — never an Apple ID, because 2FA makes
# that path unscriptable.
APPLE_TEAM_ID=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=
