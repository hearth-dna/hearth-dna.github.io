<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Apple's privacy manifest. Every list here is empty, and that is the accurate answer rather than a
  stub: Hearth collects nothing, tracks nothing, and contacts no third-party server of its own
  (docs/decisions/0001-local-first-no-personal-data-on-the-server.md). The only outbound calls the
  app makes are the document reading the user sets up with their own API key, to their own provider,
  and the backups they choose to keep in their own cloud drive: the user's relationships, not the
  app's.

  This is not the same thing as the App Store Connect privacy label, which is filled in separately
  and must say the same.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <!-- UserDefaults holds the app's own settings (language, the chosen backup place), read and
         written only by this app: reason CA92.1. No file timestamps, disk-space checks,
         active-keyboard or system-boot-time reads. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
