<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The platform's DayNight, so the window follows the phone's theme until Compose draws; the
      window background is the app's light background, so a cold start does not flash white.
    -->
    <style name="Theme.Hearth" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
