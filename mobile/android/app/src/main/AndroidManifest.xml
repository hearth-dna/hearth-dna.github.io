<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permission. Every connection goes through Egress.kt, to two kinds of place only:
      the model provider the user brings a key for (reading a document), and the cloud drive the
      user signs in to for backups. The whole database is local.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup="false" is a privacy decision, not an oversight: user.db and the files beside it
      hold the raw genomes, and Android's own backup would copy them to Google Drive. There is one
      backup path in this app, the one the user drives from Settings.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Hearth"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Where the browser returns after a Dropbox sign-in (Cloud.kt). The scheme is
              db-<app key>, filled from HEARTH_DROPBOX_APP_KEY at build time; without a key it is a
              scheme nothing ever opens. Anything may open it, which is why Cloud.kt checks the
              state it sent and PKCE makes a stolen code useless.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${dropboxScheme}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
