<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permission. It is for the web app's outbound paths in frontend/src/egress/egress.ts:
      the BYOK Ask call the user makes with their own API key, and the encrypted cloud backup the
      user signs in to. The shell's own network use is signing in to that backup (Cloud.kt) and
      nothing else; the whole database is local.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup="false" is a privacy decision, not an oversight: the WebView's storage is where
      the raw genomes live, and Android's own backup would copy that to Google Drive. There is one
      backup path in this app, the one the user drives from Settings.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Hearth"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Where the browser returns after a Dropbox sign-in (Cloud.kt). The scheme is
              db-<app key>, filled from HEARTH_DROPBOX_APP_KEY at build time; without a key it is a
              scheme nothing ever opens. Anything may open it, which is why Cloud.kt checks the
              state it sent and PKCE makes a stolen code useless.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${dropboxScheme}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
