# Copy to production.tfvars and fill in real values. Never commit production.tfvars.
# Nothing here is secret — llm-api-key, edge-shared-secret and cloudflare-api-token live in
# Secret Manager and are read by secrets.tf.

project_id  = "hearth-production"
region      = "europe-west1"
environment = "production"
image_tag   = "latest"

# Leave false for the first apply; flip once the domain and cloudflare-api-token exist.
enable_cloudflare     = false
domain                = "your-domain.example"
cloudflare_account_id = "your-cloudflare-account-id"
# web_origin = "https://app.your-domain.example"

enable_email     = false
forwarding_email = "you@example.com"

billing_account_id = "XXXXXX-XXXXXX-XXXXXX"
budget_amount_usd  = 2
alert_email        = "you@example.com"
