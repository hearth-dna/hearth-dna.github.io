# Cloudflare Pages headers. Cross-origin isolation is what lets sqlite-wasm use OPFS; the CSP is
# the enforcement of "nothing but our own origin" (docs/design.md §2, §13.2). connect-src lists
# the api host so Ask tier 3 can be enabled; everything else is self.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.hearth.example; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
